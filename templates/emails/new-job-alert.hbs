<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0;padding:0;font-family:Arial,sans-serif;background:#f5f5f5;">
  {{> header}}
  
  <div style="max-width:600px;margin:20px auto;background:#fff;padding:30px;border-radius:8px;">
    <h2 style="color:#0A2540;margin-bottom:20px;">{{first_name}}, új munka! 🔧</h2>
    
    <div style="background:#fff3cd;padding:20px;border-radius:6px;margin:20px 0;border-left:4px solid #F5B93C;">
      <p style="margin:0 0 10px;"><strong>Munkaszám:</strong> {{job_id}}</p>
      <p style="margin:0 0 10px;"><strong>Leírás:</strong> {{description}}</p>
      <p style="margin:0 0 10px;"><strong>Cím:</strong> {{address}}</p>
      <p style="margin:0 0 10px;"><strong>Távolság:</strong> {{distance}} km</p>
    </div>
    
    <p style="color:#d9534f;font-weight:600;">⚠️ Ez az ajánlat 5 perc múlva lejár!</p>
    
    <div style="margin:20px 0;">
      {{> button url=accept_url text="Elfogadom" color="#10b981"}}
      <a href="{{decline_url}}" style="display:inline-block;padding:12px 24px;background:#e5e7eb;color:#374151;text-decoration:none;border-radius:6px;font-weight:600;margin-left:10px;">Elutasítom</a>
    </div>
    
    <p style="color:#999;font-size:14px;margin-top:30px;">
      Kérdés? <a href="mailto:{{support_email}}" style="color:#3DA9FC;">{{support_email}}</a>
    </p>
  </div>
  
  {{> footer}}
</body>
</html>